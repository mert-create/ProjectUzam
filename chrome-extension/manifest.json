{
  "manifest_version": 3,
  "name": "Uzam Reklam",
  "version": "1.0.0",
  "minimum_chrome_version": "145",
  "description": "Uzam ile Chrome’da açık olan site için reklam filtresini açar veya kapatır.",
  "permissions": ["activeTab", "declarativeNetRequest"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Uzam Reklam · Açık siteyi değiştir"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "windows": "Ctrl+Shift+Y"
      }
    }
  }
}
